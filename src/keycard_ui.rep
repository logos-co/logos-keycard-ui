// QtRO view contract for the Keycard's app. A PIN, PUK or pairing password crosses it on its way
// to the card through keycard_module, and neither side keeps it. The keys stay on the card.
class KeycardUi
{
    PROP(QString statusText="Starting" READONLY)
    PROP(QString lastError="" READONLY)

    // `[{ reader, version?, initialized?, keyUid?, secureChannel?, pinRetries?, taproot?, identity?,
    // trustedByPerson?, paired, error?, untrusted? }]`; `untrusted` is the identity key of a 4.0 card
    // refused because Keycard didn't sign it.
    PROP(QString cardsJson="[]" READONLY)
    // The accounts offered to apps, public material only.
    PROP(QString accountsJson="[]" READONLY)
    PROP(QString cardGroupsJson="[]" READONLY)
    PROP(QString walletsJson="[]" READONLY)
    SLOT(bool identifyWallet(QString serial))
    SLOT(bool verifyWallet(QString walletId, QString serial))
    // The export under way or last finished: `{ state, accounts?, error? }`, `{}` before any.
    PROP(QString exportJson="{}" READONLY)
    // What the last pairing or PIN change did, `""` before any.
    PROP(QString noticeText="" READONLY)

    PROP(QString shellDevicesJson="[]" READONLY)
    PROP(QString shellGroupsJson="[]" READONLY)
    SLOT(bool addAccount(QString walletId, QString family, QString chain, int account, QString label, QString pin, QString connectionId))
    SLOT(bool renameAccount(QString walletId, QString accountId, QString name))
    SLOT(bool removeWalletAccount(QString walletId, QString accountId))
    SLOT(bool refresh())
    SLOT(QString administer(QString paramsJson))
    // Export these accounts from the card in `reader` ("" for the only one), opened by its PIN:
    // `familiesJson` lists evm, bitcoin, bitcoin_taproot; `chain` is main or test.
    SLOT(bool offer(QString reader, QString familiesJson, QString chain, int account, QString label, QString pin))
    SLOT(bool removeAccount(QString id))
    SLOT(bool renameCard(QString id, QString name))
    SLOT(bool forgetSavedCard(QString id))
    // A 3.x card only: pair it once, with its pairing password.
    SLOT(bool pair(QString reader, QString pairingPassword))
    SLOT(bool changePin(QString reader, QString pin, QString newPin))
    SLOT(bool unblockPin(QString reader, QString puk, QString newPin))
    // A 4.0 card Keycard didn't sign: trust it by its identity, once the person has confirmed they
    // loaded the applet themselves, or stop trusting it.
    SLOT(bool trustCard(QString reader, QString identity))
    SLOT(bool forgetCard(QString identity))
}
